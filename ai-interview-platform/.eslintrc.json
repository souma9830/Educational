{
  "env": {
    "node": true,
    "es2024": true,
    "jest": true,
    "browser": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "prefer-const": "warn",
    "no-var": "error",
    "eqeqeq": ["warn", "smart"],
    "no-process-exit": "warn",
    "no-throw-literal": "error",
    "prefer-template": "warn",
    "no-undef": "warn",
    "no-redeclare": "warn"
  },
  "ignorePatterns": ["node_modules", "dist", "build", "coverage", "client/src/App.jsx.bak"]
}
